package grind

// Definition for a binary tree node.
type TreeNode struct {
	Val   int
	Left  *TreeNode
	Right *TreeNode
}

// queue is BFS
func invertTree(root *TreeNode) *TreeNode {
	savedRoot := root
	if root == nil {
		return nil
	}

	queue := []*TreeNode{root}
	// queue[0] = root

	for len(queue) > 0 {
		current := queue[0]
		if current.Left == nil || cur.Right == nil {
			return current
		}

		current.Left, current.Right = current.Right, current.Left
		queue = queue[1:]
		queue = append(queue, current.Left, current.Right)

	}
	return savedRoot
}
